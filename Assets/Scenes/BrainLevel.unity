    answerA: "\u0413\u043B\u0430\u0432\u0435\u043D \u043C\u043E\u0437\u044A\u043A,
      \u0441\u044A\u0440\u0446\u0435 \u0438 \u043D\u0435\u0440\u0432\u0438"
    answerB: "\u0413\u043B\u0430\u0432\u0435\u043D \u043C\u043E\u0437\u044A\u043A,
      \u0433\u0440\u044A\u0431\u043D\u0430\u0447\u0435\u043D \u043C\u043E\u0437\u044A\u043A
      \u0438 \u043D\u0435\u0440\u0432\u0438"
    answerV: "\u0413\u0440\u044A\u0431\u043D\u0430\u0447\u0435\u043D \u043C\u043E\u0437\u044A\u043A,
      \u043C\u0443\u0441\u043A\u0443\u043B\u0438 \u0438 \u043A\u0440\u044A\u0432\u043E\u043D\u043E\u0441\u043D\u0438
      \u0441\u044A\u0434\u043E\u0432\u0435"
    answerG: "\u0413\u043B\u0430\u0432\u0435\u043D \u043C\u043E\u0437\u044A\u043A,
      \u0431\u0435\u043B\u0438 \u0434\u0440\u043E\u0431\u043E\u0432\u0435 \u0438
