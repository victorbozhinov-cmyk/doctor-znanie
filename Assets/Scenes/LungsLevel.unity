  - questionType: 0
    question: "\u041A\u043E\u0438 \u0434\u0432\u0435 \u043D\u0435\u0449\u0430 \u043F\u043E\u043C\u0430\u0433\u0430\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043C\u0430\u0445\u0430 \u0434\u0430 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0432\u0430
      \u0445\u0440\u0430\u043D\u0430\u0442\u0430?"
    answerA: "\u0421\u0442\u043E\u043C\u0430\u0448\u043D\u0438\u0442\u0435 \u0441\u043E\u043A\u043E\u0432\u0435
      \u0438 \u0436\u043B\u044A\u0447\u043A\u0430\u0442\u0430"
    answerB: "\u0421\u043B\u044E\u043D\u043A\u0430\u0442\u0430 \u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u0442\u0430
      \u043D\u0430 \u0441\u0442\u043E\u043C\u0430\u0448\u043D\u0438\u0442\u0435 \u043C\u0443\u0441\u043A\u0443\u043B\u0438"
    answerV: "\u0425\u0440\u0430\u043D\u043E\u0441\u043C\u0438\u043B\u0430\u0442\u0435\u043B\u043D\u0438\u0442\u0435
      \u0435\u043D\u0437\u0438\u043C\u0438 \u043E\u0442 \u0442\u044A\u043D\u043A\u043E\u0442\u043E
      \u0447\u0435\u0440\u0432\u043E \u0438 \u0436\u043B\u044A\u0447\u043A\u0430\u0442\u0430"
    answerG: "\u0421\u0442\u043E\u043C\u0430\u0448\u043D\u0438\u0442\u0435 \u0441\u043E\u043A\u043E\u0432\u0435
