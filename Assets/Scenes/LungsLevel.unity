  m_GameObject: {fileID: 1664709347}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87225b2ac1f75da49b9c500b026f4fe2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StomachQuizManager
  questions:
  - questionType: 0
    question: "\u041A\u044A\u0434\u0435 \u0441\u0435 \u043D\u0430\u043C\u0438\u0440\u0430
      \u0441\u0442\u043E\u043C\u0430\u0445\u044A\u0442?"
    answerA: "\u0412 \u0433\u043E\u0440\u043D\u0430\u0442\u0430 \u0434\u044F\u0441\u043D\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u043A\u043E\u0440\u0435\u043C\u0430"
    answerB: "\u0412 \u0433\u043E\u0440\u043D\u0430\u0442\u0430 \u043B\u044F\u0432\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u043A\u043E\u0440\u0435\u043C\u0430"
    answerV: "\u0412 \u0434\u043E\u043B\u043D\u0430\u0442\u0430 \u043B\u044F\u0432\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u043A\u043E\u0440\u0435\u043C\u0430"
    answerG: "\u0412 \u0434\u043E\u043B\u043D\u0430\u0442\u0430 \u0434\u044F\u0441\u043D\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u043A\u043E\u0440\u0435\u043C\u0430"
    correctAnswerIndex: 1
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438 \u0441\u0438 \u0442\u044F\u043B\u043E\u0442\u043E
      \u043E\u0442\u043F\u0440\u0435\u0434 \u0438 \u043F\u043E\u043C\u0438\u0441\u043B\u0438
      \u043E\u0442 \u043A\u043E\u044F \u0441\u0442\u0440\u0430\u043D\u0430 \u0441\u0435
      \u043D\u0430\u043C\u0438\u0440\u0430 \u0441\u0442\u043E\u043C\u0430\u0445\u044A\u0442
      \u043F\u043E\u0434 \u0440\u0435\u0431\u0440\u0430\u0442\u0430."
  - questionType: 0
    question: "\u041A\u0430\u043A\u0432\u043E \u0441\u044A\u0434\u044A\u0440\u0436\u0430\u0442
      \u0441\u0442\u043E\u043C\u0430\u0448\u043D\u0438\u0442\u0435 \u0441\u043E\u043A\u043E\u0432\u0435?"
    answerA: "\u0416\u043B\u044A\u0447\u043A\u0430 \u0438 \u0435\u043D\u0437\u0438\u043C\u0438"
    answerB: "\u0421\u043B\u044E\u043D\u043A\u0430 \u0438 \u0435\u043D\u0437\u0438\u043C\u0438"
    answerV: "\u0421\u043E\u043B\u043D\u0430 \u043A\u0438\u0441\u0435\u043B\u0438\u043D\u0430
      \u0438 \u0435\u043D\u0437\u0438\u043C\u0438"
    answerG: "\u0421\u043E\u043B\u043D\u0430 \u043A\u0438\u0441\u0435\u043B\u0438\u043D\u0430
      \u0438 \u0436\u043B\u044A\u0447\u043A\u0430"
    correctAnswerIndex: 2
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u0415\u0434\u043D\u0430\u0442\u0430 \u0441\u044A\u0441\u0442\u0430\u0432\u043A\u0430
      \u0441\u044A\u0437\u0434\u0430\u0432\u0430 \u043A\u0438\u0441\u0435\u043B\u0430
      \u0441\u0440\u0435\u0434\u0430, \u0430 \u0434\u0440\u0443\u0433\u0430\u0442\u0430
      \u043F\u043E\u043C\u0430\u0433\u0430 \u0437\u0430 \u0440\u0430\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0445\u0440\u0430\u043D\u0430\u0442\u0430."
  - questionType: 0
    question: "\u041A\u0430\u043A\u0432\u0430 \u0435 \u0435\u0434\u043D\u0430 \u043E\u0442
      \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
      \u043D\u0430 \u0441\u0442\u043E\u043C\u0430\u0448\u043D\u0438\u0442\u0435 \u0441\u043E\u043A\u043E\u0432\u0435?"
    answerA: "\u0414\u0430 \u043F\u043E\u043C\u0430\u0433\u0430\u0442 \u0437\u0430
      \u0440\u0430\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0445\u0440\u0430\u043D\u0430\u0442\u0430"
    answerB: "\u0414\u0430 \u043F\u0440\u0438\u0434\u0432\u0438\u0436\u0432\u0430\u0442
      \u0445\u0440\u0430\u043D\u0430\u0442\u0430 \u043A\u044A\u043C \u0442\u044A\u043D\u043A\u043E\u0442\u043E
      \u0447\u0435\u0440\u0432\u043E"
