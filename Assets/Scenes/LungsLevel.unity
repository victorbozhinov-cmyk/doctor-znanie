    answerA: "\u0422\u0440\u0430\u0445\u0435\u044F"
    answerB: "\u0425\u0440\u0430\u043D\u043E\u043F\u0440\u043E\u0432\u043E\u0434"
    answerV: "\u0422\u044A\u043D\u043A\u043E \u0447\u0435\u0440\u0432\u043E"
    answerG: "\u0414\u0435\u0431\u0435\u043B\u043E \u0447\u0435\u0440\u0432\u043E"
