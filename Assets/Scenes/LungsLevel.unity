  questions:
  - questionType: 0
    question: "\u041A\u044A\u0434\u0435 \u0441\u0435 \u043D\u0430\u043C\u0438\u0440\u0430
      \u0441\u0442\u043E\u043C\u0430\u0445\u044A\u0442?"
    answerA: "\u0412 \u0433\u043E\u0440\u043D\u0430\u0442\u0430 \u0434\u044F\u0441\u043D\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u043A\u043E\u0440\u0435\u043C\u0430"
    answerB: "\u0412 \u0433\u043E\u0440\u043D\u0430\u0442\u0430 \u043B\u044F\u0432\u0430
