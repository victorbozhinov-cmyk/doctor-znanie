    answerV: "\u041F\u0435\u0440\u0438\u0441\u0442\u0430\u043B\u0442\u0438\u043A\u0430"
    answerG: "\u041E\u0442\u0434\u0435\u043B\u044F\u043D\u0435 \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u043D\u0430
