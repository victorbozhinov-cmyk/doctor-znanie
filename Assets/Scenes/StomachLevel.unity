  m_Script: {fileID: 11500000, guid: dae27f7688a6a6d4d9502fd07934f60c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HeartQuizManager
  questions:
  - questionType: 0
    question: "\u041A\u0430\u043A\u0432\u0430 \u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u0442\u0430
      \u043D\u0430 \u0441\u044A\u0440\u0446\u0435\u0442\u043E?"
    answerA: "\u0438\u0437\u043F\u043E\u043C\u043F\u0432\u0430 \u043A\u0440\u044A\u0432"
    answerB: "\u043F\u0440\u0435\u0447\u0438\u0441\u0442\u0432\u0430 \u0432\u044A\u0437\u0434\u0443\u0445\u0430"
    answerV: "\u043F\u0440\u0435\u0447\u0438\u0441\u0442\u0432\u0430 \u043A\u0440\u044A\u0432\u0442\u0430"
    answerG: "\u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0436\u0434\u0430 \u043A\u0440\u044A\u0432"
    correctAnswerIndex: 0
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u0421\u044A\u0440\u0446\u0435\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0438
      \u043A\u0430\u0442\u043E \u043C\u0443\u0441\u043A\u0443\u043B\u043D\u0430 \u043F\u043E\u043C\u043F\u0430"
  - questionType: 0
    question: "\u041A\u043E\u043B\u043A\u043E \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      \u0438\u043C\u0430 \u0447\u043E\u0432\u0435\u0448\u043A\u043E\u0442\u043E \u0441\u044A\u0440\u0446\u0435?"
    answerA: 1
    answerB: 2
    answerV: 3
    answerG: 4
    correctAnswerIndex: 3
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u0421\u044A\u0431\u0435\u0440\u0438 \u0431\u0440\u043E\u044F \u043D\u0430
      \u043F\u0440\u0435\u0434\u0441\u044A\u0440\u0434\u0438\u044F\u0442\u0430 \u0438
      \u043A\u0430\u043C\u0435\u0440\u0438\u0442\u0435"
  - questionType: 0
    question: "\u041E\u0442 \u043A\u0430\u043A\u0432\u0438 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      \u0435 \u0438\u0437\u0433\u0440\u0430\u0434\u0435\u043D\u043E \u0441\u044A\u0440\u0446\u0435\u0442\u043E?"
    answerA: "\u0447\u0435\u0442\u0438\u0440\u0438 \u043F\u0440\u0435\u0434\u0441\u044A\u0440\u0434\u0438\u044F"
    answerB: "\u0447\u0435\u0442\u0438\u0440\u0438 \u043A\u0430\u043C\u0435\u0440\u0438"
    answerV: "\u0434\u0432\u0435 \u043F\u0440\u0435\u0434\u0441\u044A\u0440\u0434\u0438\u044F
      \u0438 \u0434\u0432\u0435 \u043A\u0430\u043C\u0435\u0440\u0438"
    answerG: "\u0435\u0434\u043D\u043E \u043F\u0440\u0435\u0434\u0441\u044A\u0440\u0434\u0438\u0435
      \u0438 \u0442\u0440\u0438 \u043A\u0430\u043C\u0435\u0440\u0438"
    correctAnswerIndex: 2
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u0421\u044A\u0440\u0446\u0435\u0442\u043E \u0438\u043C\u0430 \u0447\u0435\u0442\u0438\u0440\u0438
      \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043E\u0442 \u0434\u0432\u0430
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u0438 \u0432\u0438\u0434\u0430"
  - questionType: 0
    question: "\u041A\u043E\u044F \u0447\u0430\u0441\u0442 \u043D\u0430 \u0441\u044A\u0440\u0446\u0435\u0442\u043E
      \u0438\u0437\u043F\u043E\u043C\u043F\u0432\u0430 \u043A\u0440\u044A\u0432\u0442\u0430
      \u043A\u044A\u043C \u043E\u0441\u0442\u0430\u043D\u0430\u043B\u0430\u0442\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430?"
    answerA: "\u043F\u0440\u0435\u0434\u0441\u044A\u0440\u0434\u0438\u044F\u0442\u0430"
    answerB: "\u043A\u0430\u043C\u0435\u0440\u0438\u0442\u0435"
    answerV: "\u043A\u0430\u043F\u0438\u043B\u044F\u0440\u0438\u0442\u0435"
    answerG: "\u0432\u0435\u043D\u0438\u0442\u0435"
    correctAnswerIndex: 1
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u041E\u0442 \u0442\u0435\u0437\u0438 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      \u043A\u0440\u044A\u0432\u0442\u0430 \u043F\u0440\u0435\u043C\u0438\u043D\u0430\u0432\u0430
      \u0432 \u0430\u0440\u0442\u0435\u0440\u0438\u0438\u0442\u0435"
  - questionType: 0
    question: "\u041A\u044A\u0434\u0435 \u043A\u0440\u044A\u0432\u0442\u0430 \u0441\u0435
      \u0434\u0432\u0438\u0436\u0438 \u043F\u043E-\u0431\u0430\u0432\u043D\u043E?"
    answerA: "\u0432 \u0430\u0440\u0442\u0435\u0440\u0438\u0438\u0442\u0435"
    answerB: "\u0432\u044A\u0432 \u0432\u0435\u043D\u0438\u0442\u0435"
    answerV: "\u0432 \u043A\u0430\u043C\u0435\u0440\u0438\u0442\u0435"
    answerG: "\u0432 \u043F\u0440\u0435\u0434\u0441\u044A\u0440\u0434\u0438\u044F\u0442\u0430"
    correctAnswerIndex: 1
    questionImage: {fileID: 0}
    answerAImage: {fileID: 0}
    answerBImage: {fileID: 0}
    answerVImage: {fileID: 0}
    answerGImage: {fileID: 0}
    correctWrittenAnswer: 
    hint: "\u0422\u0435\u0437\u0438 \u0441\u044A\u0434\u043E\u0432\u0435 \u0432\u0440\u044A\u0449\u0430\u0442
      \u043A\u0440\u044A\u0432\u0442\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043A\u044A\u043C \u0441\u044A\u0440\u0446\u0435\u0442\u043E"
  - questionType: 0
    question: "\u041A\u044A\u0434\u0435 \u0441\u043F\u043E\u0440\u0435\u0434 \u0432\u0438\u0434\u0435\u043E\u0442\u043E
